# Copy to .env and adjust as needed. .env is gitignored.
#
# This file also configures the MySQL container: run docker compose from the
# repo root with `docker compose --env-file backend/.env up -d` so the same
# credentials provision the database and the backend connects with them.

# Port MySQL is exposed on the host (change if 3306 is already taken locally).
DB_PORT=3306

# Database name and app-level credentials. The compose file creates this
# database and user on first startup; the backend connects with the same
# values via knexfile.ts.
DB_NAME=db_name
DB_USER=user_name
DB_PASSWORD=123
DB_ROOT_PASSWORD=123

# Used by the backend (knexfile.ts) to reach the database. When the backend
# runs on the host (not in a container), DB_HOST is localhost.
DB_HOST=localhost

# Port the Express API listens on.
PORT=4000

# Secret used to sign auth JWTs. Any long random string in dev; use a real
# generated secret in production. Rotating it invalidates all issued tokens.
JWT_SECRET=dev-only-secret-change-me
