# Copy to .env and adjust as needed. .env is gitignored.
#
# This file also configures the MySQL container: run docker compose from the
# repo root with `docker compose --env-file backend/.env up -d` so the same
# credentials provision the database and the backend connects with them.

# Port MySQL is exposed on the host (change if 3306 is already taken locally).
DB_PORT=3306

# Database name and app-level credentials. The compose file creates this
# database and user on first startup; the backend connects with the same
# values via knexfile.ts.
DB_NAME=event_planner
DB_USER=event_planner_app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Used by the backend (knexfile.ts) to reach the database. When the backend
# runs on the host (not in a container), DB_HOST is localhost.
DB_HOST=localhost

# Port the Express API listens on.
PORT=4000

# Secret used to sign auth JWTs. Any long random string in dev; use a real
# generated secret in production. Rotating it invalidates all issued tokens.
JWT_SECRET=dev-only-secret-change-me


# update this recommonded  for default only warninng
TOTP_ENCRYPTION_KEY=hM4UG0/H8Czevtuo1iSY4jIRkr8vSt5aQoIqy/BaXPY=

# Base URL of the frontend, used to build links sent in emails (e.g. the
# email verification link). No trailing slash.
FRONTEND_URL=http://localhost:5173

# development | production. Controls log format (colorized text vs JSON)
# and the default log level.
NODE_ENV=development

# Origins allowed to call the API (CORS). Comma-separated for more than one
# (e.g. a staging URL alongside prod). Defaults to FRONTEND_URL if unset.
# CORS_ORIGIN=http://localhost:5173

# Set to 1 only when actually deployed behind a reverse proxy/load balancer
# (nginx, a cloud LB, etc.) -- makes Express trust X-Forwarded-For so
# rate-limiting and req.ip see the real client IP instead of the proxy's.
# TRUST_PROXY=1

# Resend API key for sending real emails (verification links, etc). Unset
# in dev -- services/mailer.ts falls back to logging the email instead.
# RESEND_API_KEY=re_...

# From address used when RESEND_API_KEY is set. Must be a verified sender
# domain in Resend for anything beyond their onboarding@resend.dev test address.
# EMAIL_FROM=Evently <onboarding@resend.dev>

